{
  "policy": "CODEX_REMOTE_DIAGNOSTIC_SAFE_METADATA_POLICY_V1_1_4",
  "activeHarness": "v1.1.4",
  "status": "diagnostic_only_non_blocking_candidate_policy",
  "safeSummaryOnly": true,
  "allowedInputs": [
    "remoteNpmDiagnosticStatus",
    "safeArtifactIndexStatus",
    "diagnosticConsolidationStatus"
  ],
  "forbiddenInputs": [
    "rawLogs",
    "rawPayloads",
    "endpoints",
    "tokens",
    "secrets",
    "privatePaths",
    "artifactContents"
  ],
  "statusAllowlist": [
    "pass",
    "fail",
    "warning",
    "not_run",
    "unknown",
    "manual_confirmation_required",
    "blocked",
    "skipped",
    "completed",
    "success",
    "failure",
    "neutral",
    "not_available",
    "available"
  ],
  "redactionPolicy": {
    "allowlistOutsideStatusHandling": "unknown_without_effect",
    "rawLikeStatusValueHandling": "unknown_without_effect",
    "rawLikeReasonCodeHandling": "unsafe_reason_code_redacted",
    "observedStatuses": "safe_allowlisted_labels_only",
    "fixedSafeReasonCodesOnly": true
  },
  "requiredBoundaries": {
    "diagnosticOnly": true,
    "nonBlocking": true,
    "passFailSemanticsChange": false,
    "targetQualityScoreSemanticsChange": false,
    "processExitCodeChange": false,
    "mergeReadySemanticsChange": false,
    "productVerificationExecutionChange": false,
    "remoteDiagnosticExecutionChange": false,
    "runtimeReadinessClaimed": false,
    "mergeReadinessClaimed": false,
    "v115Implementation": false
  },
  "neutralStatuses": [
    "not_available_without_effect",
    "unknown_without_effect",
    "available_without_effect"
  ]
}
